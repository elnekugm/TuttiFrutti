/*
 * Frutiger Aero - dark glass.
 * SPDX-License-Identifier: GPL-3.0-or-later
 *
 * A dark, glossy "deep water + glass" skin. Surfaces are translucent deep blues so the
 * ocean gradient of the window shows through, accents are aqua, and controls get a
 * soft gloss. Uses no image assets: indicators, arrows and check marks are drawn by
 * Qt itself, so the theme works on any build without extra files.
 *
 * Same structure as aero/style.qss, dark palette:
 *   window   #0a1f2e -> #0d2839      text       #eaf7ff
 *   glass    rgba(20,48,70,.60)      text2      #b9d7e6
 *   raised   rgba(38,74,102,.70)     muted      #7fa9bf
 *   sunken   rgba(16,40,60,.55)      faint      #5d7f93
 *   border   #2b5f7d                 disabled   #41637a
 *   accent   #3fd0f0  hover #63dcf7  pressed #25b4d4
 *   sel      rgba(63,208,240,.30)    soft rgba(63,208,240,.18)
 */

QWidget {
    color: #eaf7ff;
    background-color: #0a1f2e;
    selection-background-color: rgba(63, 208, 240, 0.30);
    selection-color: #ffffff;
    border: 0;
    outline: 0;
}

QWidget:disabled {
    color: #41637a;
}

QMainWindow,
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #0a1f2e, stop:0.55 #0f2b3d, stop:1 #0d2839);
}

QMainWindow::separator {
    background-color: rgba(120, 200, 235, 0.28);
    width: 1px;
    height: 1px;
}

QLabel {
    background-color: transparent;
}

QLabel:disabled {
    color: #41637a;
}

QToolTip {
    color: #eaf7ff;
    background-color: rgba(38, 74, 102, 0.70);
    border: 1px solid #2b5f7d;
    border-radius: 7px;
    padding: 6px 8px;
}

QSplitter::handle {
    background-color: rgba(120, 200, 235, 0.18);
}

QSplitter::handle:hover {
    background-color: #3fd0f0;
}

/* Menus ----------------------------------------------------------------- */

QMenuBar {
    background-color: rgba(16, 40, 60, 0.55);
    border-bottom: 1px solid #2b5f7d;
    padding: 3px 6px;
}

QMenuBar::item {
    background: transparent;
    color: #b9d7e6;
    padding: 5px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: rgba(38, 74, 102, 0.70);
    color: #eaf7ff;
}

QMenu {
    background-color: rgba(38, 74, 102, 0.70);
    border: 1px solid #2b5f7d;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    background: transparent;
    color: #eaf7ff;
    padding: 6px 28px 6px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #3fd0f0;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #41637a;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::separator {
    height: 1px;
    background: rgba(120, 200, 235, 0.28);
    margin: 4px 6px;
}

/* Buttons --------------------------------------------------------------- */

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(38, 74, 102, 0.70), stop:1 rgba(20, 48, 70, 0.60));
    color: #eaf7ff;
    border: 1px solid #2b5f7d;
    border-radius: 8px;
    padding: 0 16px;
    min-height: 30px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 rgba(38, 74, 102, 0.70));
    border-color: #63dcf7;
}

QPushButton:pressed,
QPushButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(63, 208, 240, 0.18), stop:1 rgba(63, 208, 240, 0.30));
    border-color: #25b4d4;
}

QPushButton:focus {
    border-color: #3fd0f0;
}

QPushButton:default {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #63dcf7, stop:1 #25b4d4);
    border: 1px solid #25b4d4;
    color: #ffffff;
    font-weight: 600;
}

QPushButton:default:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #7ee6fb, stop:1 #3fd0f0);
}

QPushButton:default:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #25b4d4, stop:1 #63d8f5);
}

QPushButton:disabled,
QPushButton:default:disabled {
    background: rgba(16, 40, 60, 0.55);
    border-color: #41637a;
    color: #41637a;
}

QToolButton {
    background-color: transparent;
    color: #eaf7ff;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 3px;
}

QToolButton:hover {
    background-color: rgba(38, 74, 102, 0.70);
    border-color: #2b5f7d;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: rgba(63, 208, 240, 0.18);
}

QDialogButtonBox {
    background-color: transparent;
    dialogbuttonbox-buttons-have-icons: 0;
}

QDialogButtonBox QPushButton {
    min-width: 72px;
}

/* Inputs ---------------------------------------------------------------- */

QLineEdit,
QAbstractSpinBox,
QComboBox,
QDateTimeEdit,
QPlainTextEdit,
QTextEdit {
    background-color: rgba(20, 48, 70, 0.60);
    color: #eaf7ff;
    border: 1px solid #2b5f7d;
    border-radius: 7px;
    selection-background-color: rgba(63, 208, 240, 0.30);
    selection-color: #ffffff;
}

QLineEdit,
QAbstractSpinBox,
QComboBox,
QDateTimeEdit {
    min-height: 28px;
    padding: 0 10px;
}

QLineEdit:hover,
QAbstractSpinBox:hover,
QComboBox:hover {
    border-color: #63dcf7;
}

QLineEdit:focus,
QAbstractSpinBox:focus,
QComboBox:focus,
QComboBox:on,
QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: #3fd0f0;
}

QLineEdit:disabled,
QAbstractSpinBox:disabled,
QComboBox:disabled,
QDateTimeEdit:disabled {
    background-color: rgba(16, 40, 60, 0.55);
    border-color: #41637a;
    color: #41637a;
}

QLineEdit:read-only {
    background-color: rgba(16, 40, 60, 0.55);
}

QComboBox {
    padding-right: 28px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: 0;
    background: transparent;
}

QComboBox QAbstractItemView {
    background-color: rgba(38, 74, 102, 0.70);
    border: 1px solid #2b5f7d;
    border-radius: 7px;
    padding: 4px;
    outline: 0;
    selection-background-color: #3fd0f0;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView::item {
    min-height: 26px;
    padding: 0 8px;
    border-radius: 5px;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #3fd0f0;
    color: #ffffff;
}

QComboBox[global="true"] {
    color: #7fa9bf;
}

QAbstractSpinBox {
    padding-right: 22px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    border: 0;
    background: transparent;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QCalendarWidget QWidget {
    alternate-background-color: rgba(63, 208, 240, 0.18);
}

/* Check boxes, toggles, radios: drawn, no image assets ------------------- */

QCheckBox,
QRadioButton {
    background-color: transparent;
    spacing: 10px;
    min-height: 24px;
}

QCheckBox::indicator,
QGroupBox::indicator,
QTreeView::indicator,
QListView::indicator,
QTableView::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #2b5f7d;
    border-radius: 5px;
    background: rgba(20, 48, 70, 0.60);
}

QCheckBox::indicator:hover,
QGroupBox::indicator:hover,
QAbstractItemView::indicator:hover {
    border-color: #63dcf7;
    background: rgba(38, 74, 102, 0.70);
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked,
QCheckBox::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate {
    border: 1px solid #25b4d4;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #63dcf7, stop:1 #25b4d4);
}

QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled,
QAbstractItemView::indicator:disabled,
QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled {
    border-color: #41637a;
    background: rgba(16, 40, 60, 0.55);
}

/* A setting that switches a feature on or off. ConfigurationShared::UseToggles marks it. */
QCheckBox[toggle="true"]::indicator {
    width: 34px;
    height: 20px;
    border-radius: 10px;
    border: 1px solid #2b5f7d;
    background: rgba(20, 48, 70, 0.60);
}

QCheckBox[toggle="true"]::indicator:hover {
    border-color: #63dcf7;
    background: rgba(38, 74, 102, 0.70);
}

QCheckBox[toggle="true"]::indicator:checked {
    border: 1px solid #25b4d4;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #63dcf7, stop:1 #25b4d4);
}

QCheckBox[toggle="true"]::indicator:disabled,
QCheckBox[toggle="true"]::indicator:checked:disabled {
    border-color: #41637a;
    background: rgba(16, 40, 60, 0.55);
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #2b5f7d;
    border-radius: 9px;
    background: rgba(20, 48, 70, 0.60);
}

QRadioButton::indicator:hover {
    border-color: #63dcf7;
    background: rgba(38, 74, 102, 0.70);
}

QRadioButton::indicator:checked {
    border: 5px solid rgba(38, 74, 102, 0.70);
    background: #3fd0f0;
}

QRadioButton::indicator:disabled,
QRadioButton::indicator:checked:disabled {
    border-color: #41637a;
    background: rgba(16, 40, 60, 0.55);
}

/* Per-game settings: a value changed for this game, and its reset button. */
ConfigurationShared--Widget[custom="true"] QLabel,
ConfigurationShared--Widget[custom="true"] QCheckBox {
    color: #eaf7ff;
    font-weight: 600;
}

ConfigurationShared--Widget[custom="true"] QComboBox,
ConfigurationShared--Widget[custom="true"] QLineEdit,
ConfigurationShared--Widget[custom="true"] QAbstractSpinBox {
    border-color: #3fd0f0;
}

QPushButton[restore="true"] {
    background-color: rgba(63, 208, 240, 0.18);
    border: 0;
    border-radius: 6px;
    padding: 0;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}

QPushButton[restore="true"]:hover {
    background-color: rgba(63, 208, 240, 0.30);
}

/* Sliders and progress -------------------------------------------------- */

QSlider {
    background-color: transparent;
}

QSlider::groove:horizontal {
    height: 6px;
    border-radius: 3px;
    background-color: rgba(16, 40, 60, 0.55);
    border: 1px solid #2b5f7d;
}

QSlider::sub-page:horizontal {
    height: 6px;
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #63dcf7, stop:1 #3fd0f0);
}

QSlider::sub-page:horizontal:disabled {
    background-color: #41637a;
}

QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border-radius: 9px;
    border: 2px solid rgba(38, 74, 102, 0.70);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 #123a52);
}

QSlider::handle:horizontal:disabled {
    background-color: #41637a;
}

QSlider::groove:vertical {
    width: 6px;
    border-radius: 3px;
    background-color: rgba(16, 40, 60, 0.55);
    border: 1px solid #2b5f7d;
}

QSlider::add-page:vertical {
    width: 6px;
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
                                stop:0 #63dcf7, stop:1 #3fd0f0);
}

QSlider::handle:vertical {
    width: 18px;
    height: 18px;
    margin: 0 -7px;
    border-radius: 9px;
    border: 2px solid rgba(38, 74, 102, 0.70);
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ffffff, stop:1 #123a52);
}

QProgressBar {
    background-color: rgba(16, 40, 60, 0.55);
    border: 1px solid #2b5f7d;
    border-radius: 7px;
    color: #b9d7e6;
    text-align: center;
    min-height: 14px;
}

QProgressBar::chunk {
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #7ed957, stop:1 #5ed08a);
}

/* Scroll bars ----------------------------------------------------------- */

QScrollArea,
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QAbstractScrollArea::corner {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: rgba(120, 200, 235, 0.28);
    min-height: 32px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(120, 200, 235, 0.28);
    min-width: 32px;
    border-radius: 4px;
}

QScrollBar::handle:hover {
    background-color: #3fd0f0;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    width: 0;
    height: 0;
    border: 0;
}

/* Tabs ------------------------------------------------------------------ */

QTabWidget::pane {
    border: 1px solid #2b5f7d;
    border-radius: 10px;
    background-color: rgba(16, 40, 60, 0.55);
    top: -1px;
}

QTabWidget::tab-bar {
    left: 12px;
}

QTabBar {
    background-color: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background: rgba(16, 40, 60, 0.55);
    color: #b9d7e6;
    border: 1px solid #2b5f7d;
    border-bottom: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 9px 16px;
    margin-right: 3px;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: #eaf7ff;
    background: rgba(38, 74, 102, 0.70);
}

QTabBar::tab:selected {
    color: #eaf7ff;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ffffff, stop:1 rgba(38, 74, 102, 0.70));
    border-bottom: 2px solid #3fd0f0;
    font-weight: 600;
}

QTabBar::tab:disabled {
    color: #41637a;
}

QTabBar QToolButton {
    background-color: rgba(38, 74, 102, 0.70);
    border: 1px solid #2b5f7d;
    border-radius: 6px;
    width: 24px;
    margin: 6px 1px;
}

QTabBar::scroller {
    width: 56px;
}

/* Group boxes become section headers ------------------------------------ */

QGroupBox {
    background-color: transparent;
    border: 0;
    border-top: 1px solid rgba(120, 200, 235, 0.28);
    margin-top: 26px;
    padding-top: 6px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    top: 4px;
    color: #3fd0f0;
    background-color: transparent;
}

/* Item views: game list, category list, trees --------------------------- */

QAbstractItemView {
    background-color: rgba(16, 40, 60, 0.55);
    alternate-background-color: rgba(63, 208, 240, 0.18);
    border: 0;
    selection-background-color: rgba(63, 208, 240, 0.30);
    selection-color: #eaf7ff;
    show-decoration-selected: 1;
}

QAbstractItemView::item {
    border: 0;
}

QAbstractItemView::item:hover {
    background-color: rgba(20, 48, 70, 0.60);
}

QAbstractItemView::item:selected,
QAbstractItemView::item:selected:active,
QAbstractItemView::item:selected:!active {
    background-color: rgba(63, 208, 240, 0.30);
    color: #eaf7ff;
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:selected {
    background-color: rgba(63, 208, 240, 0.30);
}

QHeaderView {
    background-color: transparent;
    border: 0;
}

QHeaderView::section {
    background-color: rgba(16, 40, 60, 0.55);
    color: #b9d7e6;
    border: 0;
    border-bottom: 1px solid #2b5f7d;
    padding: 0 8px;
    min-height: 32px;
}

QHeaderView::section:hover {
    color: #eaf7ff;
}

QTableView {
    gridline-color: rgba(120, 200, 235, 0.28);
}

QTableCornerButton::section {
    background-color: rgba(16, 40, 60, 0.55);
    border: 0;
}

QScrollArea QListWidget {
    background-color: rgba(16, 40, 60, 0.55);
    border: 1px solid #2b5f7d;
    border-radius: 8px;
}

/* Configure: category list on the left */
QListWidget#selectorList {
    background-color: rgba(16, 40, 60, 0.55);
    border: 0;
    border-right: 1px solid #2b5f7d;
    padding: 12px 8px;
    outline: 0;
}

QListWidget#selectorList::item {
    color: #b9d7e6;
    min-height: 34px;
    padding: 0 10px;
    border-radius: 8px;
    margin-bottom: 2px;
}

QListWidget#selectorList::item:hover {
    background-color: rgba(38, 74, 102, 0.70);
}

QListWidget#selectorList::item:selected {
    background-color: rgba(63, 208, 240, 0.30);
    color: #eaf7ff;
    font-weight: 600;
}

/* Per-game Properties: the game's info column */
QDialog#ConfigurePerGame QGroupBox#gameInfo {
    background-color: rgba(16, 40, 60, 0.55);
    border: 0;
    border-right: 1px solid #2b5f7d;
    margin-top: 0;
    padding: 16px 12px;
}

QDialog#ConfigurePerGame QGroupBox#gameInfo::title {
    color: transparent;
}

QDialog#ConfigurePerGame QGroupBox#gameInfo QLineEdit {
    background-color: transparent;
    border: 0;
    border-bottom: 1px solid #2b5f7d;
    border-radius: 0;
    padding: 0 2px;
    color: #eaf7ff;
}

QDialog#ConfigurePerGame QGraphicsView {
    border-radius: 10px;
    background-color: rgba(20, 48, 70, 0.60);
}

QDialog#ConfigureDialog QLabel#label,
QDialog#ConfigurePerGame QLabel#label_8 {
    color: #7fa9bf;
}

/* About, What's new ----------------------------------------------------- */

QDialog#AboutDialog QLabel#labelAbout {
    color: #b9d7e6;
}

QDialog#AboutDialog QLabel#labelBuildInfo,
QDialog#AboutDialog QLabel#labelLiability {
    color: #7fa9bf;
}

QDialog#WhatsNewDialog QLabel#WhatsNewText {
    color: #b9d7e6;
}

QDialog#WhatsNewDialog QLabel#WhatsNewBadge {
    background-color: rgba(63, 208, 240, 0.18);
    border-radius: 8px;
}

QDialog#WhatsNewDialog QWidget#WhatsNewItem {
    border-bottom: 1px solid #2b5f7d;
}

QDialog#WhatsNewDialog QWidget#WhatsNewFooter {
    background-color: rgba(16, 40, 60, 0.55);
    border-top: 1px solid #2b5f7d;
}

/* Status bar: setting chips on the left, stats on the right ------------- */

QStatusBar {
    background-color: rgba(16, 40, 60, 0.55);
    border-top: 1px solid #2b5f7d;
    color: #b9d7e6;
}

QStatusBar::item {
    border: 0;
}

QStatusBar QLabel {
    color: #b9d7e6;
    padding: 0 4px;
}

QPushButton#TogglableStatusBarButton,
QPushButton#RendererStatusBarButton,
QPushButton#GPUStatusBarButton,
QPushButton#DockingStatusBarButton {
    min-height: 20px;
    max-height: 20px;
    padding: 0 6px;
    margin: 0;
    border: 0;
    border-radius: 7px;
    background-color: rgba(20, 48, 70, 0.60);
    color: #b9d7e6;
    font-size: 11px;
}

QPushButton#GPUStatusBarButton[chip="gpu"] {
    background-color: rgba(240, 189, 84, 0.20);
    color: #f0bd54;
}

QPushButton#DockingStatusBarButton[chip="dock"] {
    background-color: rgba(63, 208, 240, 0.22);
    color: #63d8f5;
}

QPushButton#TogglableStatusBarButton[chip="filter"] {
    background-color: rgba(142, 224, 106, 0.20);
    color: #8ee06a;
}

QPushButton#TogglableStatusBarButton[chip="aa"] {
    background-color: rgba(63, 208, 240, 0.22);
    color: #63d8f5;
}

QPushButton#TogglableStatusBarButton[chip="fx"] {
    background-color: rgba(142, 224, 106, 0.20);
    color: #8ee06a;
}

QPushButton#TogglableStatusBarButton[chip="fg"] {
    background-color: rgba(240, 189, 84, 0.20);
    color: #f0bd54;
}

QPushButton#TogglableStatusBarButton[chip="volume"] {
    background-color: rgba(231, 155, 217, 0.20);
    color: #e79bd9;
}

QPushButton#TogglableStatusBarButton:!checked {
    background-color: transparent;
    color: #5d7f93;
}

QPushButton#RendererStatusBarButton {
    background-color: rgba(63, 208, 240, 0.18);
    color: #25b4d4;
}

QPushButton#TogglableStatusBarButton:hover,
QPushButton#RendererStatusBarButton:hover,
QPushButton#GPUStatusBarButton:hover,
QPushButton#DockingStatusBarButton:hover {
    background-color: #3fd0f0;
    color: #ffffff;
}

QPushButton#RefreshButton {
    min-height: 20px;
    max-height: 20px;
    padding: 0 4px;
    border: 0;
    background-color: transparent;
    color: #7fa9bf;
}

QPushButton#RefreshButton:hover {
    color: #eaf7ff;
}

QPushButton#buttonRefreshDevices {
    min-width: 30px;
    max-width: 30px;
    padding: 0;
}

QPushButton#button_reset_defaults {
    padding: 0 12px;
}

/* Controller applet, input pages ---------------------------------------- */

QWidget[compactPage="true"] QPushButton {
    padding: 0 6px;
}

QSpinBox#spinboxLStickRange,
QSpinBox#spinboxRStickRange,
QSpinBox#vibrationSpinPlayer1,
QSpinBox#vibrationSpinPlayer2,
QSpinBox#vibrationSpinPlayer3,
QSpinBox#vibrationSpinPlayer4,
QSpinBox#vibrationSpinPlayer5,
QSpinBox#vibrationSpinPlayer6,
QSpinBox#vibrationSpinPlayer7,
QSpinBox#vibrationSpinPlayer8,
QSpinBox#spinTriggerRumble {
    min-width: 68px;
}

QWidget#bottomPerGameInput,
QWidget#topControllerApplet,
QWidget#bottomControllerApplet,
QWidget#Player1LEDs,
QWidget#Player2LEDs,
QWidget#Player3LEDs,
QWidget#Player4LEDs,
QWidget#Player5LEDs,
QWidget#Player6LEDs,
QWidget#Player7LEDs,
QWidget#Player8LEDs,
